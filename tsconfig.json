{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/lib/auth/supabase-context.tsx",
    "src/lib/supabase/client.ts",
    "src/lib/auth/validation.ts",
    "src/lib/auth/validation.test.ts",
    "src/lib/employer/validation.ts",
    "src/lib/employer/validation.test.ts"
  ]
}
